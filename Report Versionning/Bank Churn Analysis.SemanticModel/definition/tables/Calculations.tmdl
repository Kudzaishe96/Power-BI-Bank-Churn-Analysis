table Calculations
	lineageTag: fbc5393d-2cfb-497e-b474-6e7487d2eea0

	measure 'Total Clients' = DISTINCTCOUNT(Bank_Churn[CustomerId])
		formatString: 0
		lineageTag: 65da481f-7731-423b-9591-468714a4ac62

	measure 'Total Active Clients' = CALCULATE(DISTINCTCOUNT(Bank_Churn[CustomerId]),Bank_Churn[Exited]=="Active")
		formatString: 0
		lineageTag: fa4519cc-c52b-4093-a8d0-0bd71a8c7af7

	measure 'Total Churned Clients' = CALCULATE(DISTINCTCOUNT(Bank_Churn[CustomerId]),Bank_Churn[Exited]=="Churned")
		formatString: 0
		lineageTag: 5e589174-4aa0-488c-9998-89c68287f68e

	measure 'Churn Rate%' = ```
			
			    VAR Total_Clients = CALCULATE(
			                                    DISTINCTCOUNT(Bank_Churn[CustomerId]),ALL(Bank_Churn)
			                                )
			    
			    VAR Exited_Clients = CALCULATE(
			                                    DISTINCTCOUNT(Bank_Churn[CustomerId]),Bank_Churn[Exited] == "Churned"
			                                )
			
			    RETURN
			    DIVIDE(Exited_Clients,Total_Clients,0)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8e94b39c-dd08-4513-9d4c-05cc6a586505

	measure 'AVG Salary' = AVERAGEX(Bank_Churn,Bank_Churn[EstimatedSalary])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: c89fa489-3d25-49d4-b34b-229e28e7cb1c

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'AVG Balance' = AVERAGEX(Bank_Churn,Bank_Churn[Balance])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 43e99662-391b-4d78-a48f-c387ccbd8103

	measure Males = CALCULATE(DISTINCTCOUNT(Bank_Churn[CustomerId]),Bank_Churn[Gender] == "Male")
		formatString: 0
		lineageTag: 88673535-b411-4123-8ab8-a45e873b391c

	measure Females = CALCULATE(DISTINCTCOUNT(Bank_Churn[CustomerId]),Bank_Churn[Gender] == "Female")
		formatString: 0
		lineageTag: 534f9b66-f096-4ee9-9c1a-57f27031e270

	measure 'females Churn Rate%' = ```
			
			    VAR Total_Clients = CALCULATE(
			                                    DISTINCTCOUNT(Bank_Churn[CustomerId]),ALL(Bank_Churn)
			                                )
			    
			    VAR Exited_Female_Clients = CALCULATE(
			                                    DISTINCTCOUNT(Bank_Churn[CustomerId]),Bank_Churn[Exited] == "Churned"
			                                                                        ,Bank_Churn[Gender] =="Female"
			                                )
			
			    RETURN
			    DIVIDE(Exited_Female_Clients,Total_Clients,0)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 123f6f85-0ee6-43cc-8767-797410e7c529

	measure 'Male Churn Rate%' = ```
			
			    VAR Total_Clients = CALCULATE(
			                                    DISTINCTCOUNT(Bank_Churn[CustomerId]),ALL(Bank_Churn)
			                                )
			    
			    VAR Exited_Male_Clients = CALCULATE(
			                                    DISTINCTCOUNT(Bank_Churn[CustomerId]),Bank_Churn[Exited] == "Churned"
			                                                                        ,Bank_Churn[Gender] =="Male"
			                                )
			
			    RETURN
			    DIVIDE(Exited_Male_Clients,Total_Clients,0)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 63217963-bb18-45b9-ae21-e36664d10a47

	measure 'AVG Credit Score' = AVERAGEX(Bank_Churn,Bank_Churn[CreditScore])
		lineageTag: a2dc0e0c-90c1-4934-821c-a2b38b48ce98

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Female Churned Clients' =
			CALCULATE(DISTINCTCOUNT(Bank_Churn[CustomerId])
			                                ,Bank_Churn[Exited]=="Churned",Bank_Churn[Gender]=="Female"
			                                )
		formatString: 0
		lineageTag: 84c89a63-c748-49af-ad50-20f2fba6c93d

	measure 'Total Male Churned Clients' =
			CALCULATE(DISTINCTCOUNT(Bank_Churn[CustomerId])
			                                ,Bank_Churn[Exited]=="Churned",Bank_Churn[Gender]=="Male"
			                                )
		formatString: 0
		lineageTag: 553af67c-c828-41c8-bd2d-c82b81dbaeb9

	measure 'Dummy credit score max' = (MAXX(VALUES(CreditScore[CreditScoreGroup]),[Total Active Clients]))*1.25
		formatString: 0
		lineageTag: 3a43f29b-12c1-4a5d-bb7e-05f8cb214a89

	measure 'Dummy active clients max' = (MAXX(VALUES('Age Catergory'[AgeCategory]),[Total Active Clients]))*1.25
		lineageTag: 40d567f4-2bed-49a2-b489-ec0d3ddf4145

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Dummy active clients max Accounts' = (MAXX(VALUES(Accounts[NumberOfAccounts]),[Total Active Clients]))*1.25
		lineageTag: 10912b94-94a8-406c-a7e6-bfc231255719

		annotation PBI_FormatHint = {"isGeneralNumber":true}

