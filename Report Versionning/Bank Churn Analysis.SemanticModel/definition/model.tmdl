model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Bank_Churn","Calculations","Age Catergory","Accounts","CreditScore"]

annotation PBI_ProTooling = ["DevMode"]

ref table Bank_Churn
ref table Calculations
ref table 'Age Catergory'
ref table Accounts
ref table CreditScore
ref table 'Churned and Active Clients'

ref cultureInfo en-US

